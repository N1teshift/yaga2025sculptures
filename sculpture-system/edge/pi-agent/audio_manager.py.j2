import os
import subprocess
import logging
import re
import random

# pwd is Unix-only; importing lazily keeps this module importable cross-platform
# (the docker sim image is Linux, where it is available).
try:
    import pwd
except ImportError:
    pwd = None

logger = logging.getLogger(__name__)

SIMULATION = os.environ.get("SIMULATION", "0") == "1"

# Known ALSA control ranges for the IQaudIO Pi-CodecZero HAT. Used as a fallback
# when the live `amixer` query is unavailable (simulation or parse failure).
IQAUDIO_RANGES = {
    'Lineout': (0, 63),
    'Headphone': (0, 63),
    'ADC': (0, 127),
    'Mic': (0, 7),
}


def get_pactl_env():
    """Environment for running pactl from a systemd service (PulseAudio mode)."""
    try:
        if pwd is None:
            return os.environ.copy()
        pi_uid = pwd.getpwnam('pi').pw_uid
        env = os.environ.copy()
        env['XDG_RUNTIME_DIR'] = f'/run/user/{pi_uid}'
        return env
    except KeyError:
        logger.warning("Could not find user 'pi' for XDG_RUNTIME_DIR; pactl may fail.")
        return os.environ.copy()
    except Exception as e:
        logger.error(f"Unexpected error building pactl env: {e}")
        return os.environ.copy()


def get_alsa_control_range(card, control):
    """Return (min, max) for an ALSA control, querying amixer or using known ranges."""
    try:
        result = subprocess.run(
            ['amixer', '-c', card, 'get', control],
            capture_output=True, text=True, check=True
        )
        limits_match = re.search(r'Limits:\s*(?:Playback\s+|Capture\s+)?(\d+)\s*-\s*(\d+)', result.stdout)
        if limits_match:
            min_val, max_val = int(limits_match.group(1)), int(limits_match.group(2))
            logger.info(f"Found {control} range: {min_val}-{max_val}")
            return min_val, max_val
        logger.warning(f"Could not parse range for {control}; using known range.")
    except (subprocess.CalledProcessError, FileNotFoundError):
        logger.warning(f"amixer unavailable for {control}; using known range.")
    for key, rng in IQAUDIO_RANGES.items():
        if key in control:
            return rng
    return 0, 100


def _simulated_level(base=-30.0, spread=12.0):
    """Plausible fake dB level for simulation (no real audio hardware)."""
    return round(base + random.uniform(-spread, spread), 1)


class AudioManager:
    """Handles all audio-related operations for the sculpture system."""

    def __init__(self, audio_backend='pulse', audio_config_path=None):
        self.audio_backend = audio_backend
        self.audio_config = {
            'samplerate': '{{ audio_sample_rate }}',
            'device': '{{ mpv_audio_device }}',
            'format': '{{ mpv_audio_format }}'
        }
        self.is_muted = False
        self._last_mute_error = None
        self._headphone_range = None
        logger.info(f"AudioManager initialized in '{self.audio_backend}' mode (sim={SIMULATION})")

    def _get_headphone_range(self):
        if self._headphone_range is None:
            self._headphone_range = get_alsa_control_range('IQaudIOCODEC', 'Headphone')
        return self._headphone_range

    def _run(self, cmd, env=None):
        """Run a subprocess command, or no-op in simulation (logs the intent)."""
        if SIMULATION:
            logger.info(f"[sim] would run: {' '.join(cmd)}")
            return
        subprocess.run(cmd, check=True, capture_output=True, env=env)

    def set_volume(self, volume):
        try:
            logger.info(f"Setting volume to {volume:.3f} using {self.audio_backend} backend")
            if self.audio_backend == 'pulse':
                volume_percent = max(0, min(100, int(volume * 100)))
                cmd = ['pactl', 'set-sink-volume',
                       'alsa_output.platform-soc_sound.stereo-fallback', f'{volume_percent}%']
                self._run(cmd, env=get_pactl_env())
            else:
                min_val, max_val = self._get_headphone_range()
                alsa_value = max(min_val, min(max_val, int(min_val + volume * (max_val - min_val))))
                cmd = ['amixer', '-c', 'IQaudIOCODEC', 'sset', 'Headphone', str(alsa_value)]
                logger.info(f"ALSA Headphone volume set to {alsa_value}/{max_val} ({volume:.1%})")
                self._run(cmd)
        except subprocess.CalledProcessError as e:
            logger.error(f"Failed to set volume: {e}")
            raise

    def set_mute(self, mute):
        self.is_muted = bool(mute)
        try:
            logger.info(f"Setting mute to {self.is_muted} using {self.audio_backend} backend")
            if self.audio_backend == 'pulse':
                cmd = ['pactl', 'set-sink-mute',
                       'alsa_output.platform-soc_sound.stereo-fallback',
                       '1' if self.is_muted else '0']
                self._run(cmd, env=get_pactl_env())
            else:
                cmd = ['amixer', '-c', 'IQaudIOCODEC', 'set', 'Headphone',
                       'off' if self.is_muted else 'on']
                self._run(cmd)
            self._last_mute_error = None
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            logger.error(f"Failed to set mute using {self.audio_backend}: {e}")
            raise

    def get_mute_status(self, current_mode):
        if current_mode == "idle":
            return self.is_muted
        try:
            if self.audio_backend == 'pulse':
                mute_result = subprocess.run(
                    ['pactl', 'get-sink-mute', 'alsa_output.platform-soc_sound.stereo-fallback'],
                    capture_output=True, text=True, check=True, env=get_pactl_env()
                )
                self.is_muted = 'yes' in mute_result.stdout.lower()
            else:
                mute_result = subprocess.run(
                    ['amixer', '-c', 'IQaudIOCODEC', 'get', 'Headphone'],
                    capture_output=True, text=True, check=True
                )
                self.is_muted = '[off]' in mute_result.stdout
            self._last_mute_error = None
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            if self._last_mute_error is None:
                logger.warning(f"Could not get mute status: {e}. Using last known value.")
                self._last_mute_error = str(e)
        return self.is_muted

    def get_microphone_level(self):
        if SIMULATION:
            return _simulated_level(-35.0, 15.0)
        mic_level = -60.0
        try:
            if self.audio_backend == 'pulse':
                out = subprocess.check_output(
                    "timeout 0.1s parec --raw --device=@DEFAULT_SOURCE@ | od -t d2 -w2 | awk 'BEGIN{max=0} {val=$2; if(val<0) val=-val; if(val>max)max=val} END{print 20*(log( (max+0.0001) / 32767) / log(10))}'",
                    shell=True, timeout=0.5, stderr=subprocess.PIPE, env=get_pactl_env())
                mic_level = float(out.strip())
            else:
                out = subprocess.check_output(
                    "timeout 0.2s arecord -D mono_capture -f S16_LE -r 48000 -c 1 -t raw 2>/dev/null | od -t d2 -w2 | awk 'BEGIN{max=0} {val=$2; if(val<0) val=-val; if(val>max)max=val} END{if(max>0){print 20*log(max/32767)/log(10)} else {print -60}}'",
                    shell=True, timeout=0.7, stderr=subprocess.PIPE)
                mic_level = float(out.strip())
            if mic_level < -60 or mic_level > 0:
                mic_level = -60.0
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, ValueError):
            pass
        return mic_level

    def get_output_level(self):
        if SIMULATION:
            return _simulated_level(-28.0, 10.0)
        output_level = -60.0
        try:
            if self.audio_backend == 'pulse':
                out = subprocess.check_output(
                    "timeout 1s parec --raw --device=alsa_output.platform-soc_sound.stereo-fallback.monitor | od -t d2 -w2 | awk 'BEGIN{max=0} {val=$2; if(val<0) val=-val; if(val>max)max=val} END{if(max>0){print 20*log(max/32767)/log(10)} else {print -60}}'",
                    shell=True, timeout=2, stderr=subprocess.PIPE, env=get_pactl_env())
                output_level = float(out.strip())
            else:
                # ponytail: asound pcm.monitor depends on snd-aloop which the
                # playbook never loads; fall back to volume-based estimate.
                try:
                    vol_result = subprocess.run(
                        ['amixer', '-c', 'IQaudIOCODEC', 'get', 'Headphone'],
                        capture_output=True, text=True, check=True)
                    vol_match = re.search(r'\[(\d+)%\]', vol_result.stdout)
                    if vol_match and int(vol_match.group(1)) > 0:
                        output_level = -60 + (54 * (int(vol_match.group(1)) / 100) ** 0.5)
                    else:
                        output_level = -60.0
                except (subprocess.CalledProcessError, FileNotFoundError):
                    output_level = -60.0
            if output_level < -60 or output_level > 0:
                output_level = max(-60.0, min(0.0, output_level))
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, ValueError):
            pass
        return output_level

    def set_capture(self, capture):
        try:
            logger.info(f"Setting capture to {capture:.3f} using {self.audio_backend} backend")
            if self.audio_backend == 'pulse':
                capture_percent = max(0, min(100, int(capture * 100)))
                cmd = ['pactl', 'set-source-volume',
                       'alsa_input.platform-soc_sound.stereo-fallback', f'{capture_percent}%']
                self._run(cmd, env=get_pactl_env())
            else:
                mic2_min, mic2_max = 0, 7
                mic2_value = max(mic2_min, min(mic2_max, int(mic2_min + capture * (mic2_max - mic2_min))))
                cmd = ['amixer', '-c', 'IQaudIOCODEC', 'set', 'Mic 2', str(mic2_value)]
                logger.info(f"ALSA Mic 2 set to {mic2_value}/{mic2_max}")
                self._run(cmd)
                try:
                    self._run(['amixer', '-c', 'IQaudIOCODEC', 'set', 'ADC', '100'])
                except subprocess.CalledProcessError as e:
                    logger.warning(f"Failed to set optimal ADC level: {e}")
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            logger.error(f"Failed to set capture using {self.audio_backend}: {e}")
            raise
