import os
import subprocess
import logging

logger = logging.getLogger(__name__)

SIMULATION = os.environ.get("SIMULATION", "0") == "1"


class ServiceManager:
    def _run(self, *args, check=True):
        if SIMULATION:
            logger.info(f"[sim] would run: {' '.join(args)}")
            return
        subprocess.run(list(args), check=check)

    def switch_to_live_mode(self):
        logger.info("Switching to live mode")
        self._run('sudo', 'systemctl', 'stop', 'player-loop.service', check=False)
        self._run('sudo', 'systemctl', 'start', 'darkice.service')
        self._run('sudo', 'systemctl', 'start', 'player-live.service')

    def switch_to_local_mode(self, track=None, audio_config=None, update_loop_content=None):
        logger.info(f"Switching to local mode with track/playlist: {track}")
        self._run('sudo', 'systemctl', 'stop', 'darkice.service', check=False)
        self._run('sudo', 'systemctl', 'stop', 'player-live.service', check=False)
        if track and update_loop_content:
            update_loop_content(track, audio_config)
        self._run('sudo', 'systemctl', 'restart', 'player-loop.service')

    def stop_all_services(self):
        logger.info("Stopping all audio services due to emergency stop command.")
        self._run('sudo', 'systemctl', 'stop', 'player-loop.service', check=False)
        self._run('sudo', 'systemctl', 'stop', 'player-live.service', check=False)
        self._run('sudo', 'systemctl', 'stop', 'darkice.service', check=False)

    def restart_darkice(self):
        logger.info("Restarting darkice.service")
        self._run('sudo', 'systemctl', 'restart', 'darkice.service')

    def restart_all_services(self, current_mode):
        logger.info(f"Restarting all sculpture services (mode={current_mode})...")
        self._run('sudo', 'systemctl', 'stop', 'player-live.service', check=False)
        self._run('sudo', 'systemctl', 'stop', 'player-loop.service', check=False)
        self._run('sudo', 'systemctl', 'stop', 'darkice.service', check=False)
        self._run('sudo', 'systemctl', 'start', 'darkice.service')
        if current_mode == "live":
            self._run('sudo', 'systemctl', 'start', 'player-live.service')
        elif current_mode == "local":
            self._run('sudo', 'systemctl', 'start', 'player-loop.service')
        self._run('sudo', 'systemctl', 'restart', 'pi-agent.service')
