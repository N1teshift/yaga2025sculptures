<icecast>
    <location>Sculpture Installation</location>
    <admin>admin@sculpture.local</admin>

    <limits>
        <clients>100</clients>
        <sources>10</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>{{ icecast_admin_password | default("hackme") }}</source-password>
        <relay-password>{{ icecast_admin_password | default("hackme") }}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>{{ icecast_admin_password | default("hackme") }}</admin-password>
    </authentication>

    <hostname>{{ ansible_default_ipv4.address }}</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    {% set pw = icecast_admin_password | default("hackme") %}
    {# Microphone input mounts (one per sculpture) #}
    {% for i in range(1, (sculpture_count | default(3)) + 1) %}
    <mount type="normal">
        <mount-name>/s{{ i }}-mic.ogg</mount-name>
        <username>source</username>
        <password>{{ pw }}</password>
        <max-listeners>20</max-listeners>
        <dump-file>/tmp/s{{ i }}-mic.dump</dump-file>
        <burst-size>65536</burst-size>
        <fallback-mount>/silence.ogg</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-when-full>
        <intro>/intro.ogg</intro>
        <hidden>0</hidden>
        <public>0</public>
        <stream-name>Sculpture {{ i }} Microphone</stream-name>
        <stream-description>Live audio from sculpture {{ i }}</stream-description>
        <stream-url>http://sculpture.local</stream-url>
        <genre>ambient</genre>
        <bitrate>128</bitrate>
        <type>application/ogg</type>
        <subtype>vorbis</subtype>
    </mount>
    {% endfor %}

    {# Personalized mix output mounts (one per sculpture) #}
    {% for i in range(1, (sculpture_count | default(3)) + 1) %}
    <mount type="normal">
        <mount-name>/mix-for-{{ i }}.ogg</mount-name>
        <username>source</username>
        <password>{{ pw }}</password>
        <max-listeners>20</max-listeners>
        <dump-file>/tmp/mix-for-{{ i }}.dump</dump-file>
        <burst-size>65536</burst-size>
        <hidden>0</hidden>
        <public>0</public>
        <stream-name>Mix for Sculpture {{ i }}</stream-name>
        <stream-description>Personalized mix for sculpture {{ i }}</stream-description>
        <stream-url>http://sculpture.local</stream-url>
        <genre>ambient</genre>
        <bitrate>128</bitrate>
        <type>application/ogg</type>
        <subtype>opus</subtype>
    </mount>
    {% endfor %}

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
